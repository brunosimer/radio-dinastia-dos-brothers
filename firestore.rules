rules_version = '2';
// radioComments/{pageId}/comments/{commentId}: uid, author, body, createdAt.
// Conversas públicas por episódio; criação autenticada; exclusão só pelo autor.
service cloud.firestore {
  match /databases/{database}/documents {
    function validPage(pageId) {
      return pageId in ['home', 'central', 'week-4', 'week-5', 'week-6', 'week-7-8', 'preview-week-4', 'episode-2026-10-02'];
    }
    function isAuthenticated() { return request.auth != null; }
    function isOwner() { return isAuthenticated() && resource.data.uid == request.auth.uid; }
    function isValidComment(data) {
      return data.keys().hasOnly(['uid', 'author', 'body', 'createdAt'])
        && data.keys().hasAll(['uid', 'author', 'body', 'createdAt'])
        && data.uid == request.auth.uid
        && data.author is string && data.author.size() >= 2 && data.author.size() <= 32
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 500
        && data.createdAt == request.time;
    }
    match /radioComments/{pageId}/comments/{commentId} {
      allow read: if validPage(pageId);
      allow create: if validPage(pageId) && isAuthenticated()
        && request.auth.token.email_verified == true && isValidComment(request.resource.data);
      allow delete: if validPage(pageId) && isOwner();
      allow update: if false;
    }
  }
}
